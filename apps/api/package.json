{
	"name": "@bluprint/api",
	"private": true,
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "nest start --watch",
		"start": "node dist/main",
		"test": "jest",
		"test:unit": "jest --testPathIgnorePatterns \"\\.int-spec\\.ts$\"",
		"test:int": "jest --testPathPatterns \"\\.int-spec\\.ts$\"",
		"typecheck": "tsc --noEmit",
		"build": "nest build",
		"lint": "eslint . && prettier --check .",
		"lint:fix": "eslint . --fix && prettier --write .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@bluprint/shared": "workspace:*",
		"@nestjs/common": "^11.2.3",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.2.3",
		"@nestjs/platform-express": "^11.2.3",
		"drizzle-orm": "^0.45.2",
		"nestjs-zod": "^5.5.0",
		"pg": "^8.23.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.2.3",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.10.1",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.12.0",
		"jest": "^30.3.1",
		"prettier": "^3.9.6",
		"supertest": "^7.1.5",
		"ts-jest": "^29.4.12",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.69.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": "\\.(int-)?spec\\.ts$",
		"setupFiles": [
			"<rootDir>/test/setup-env.ts"
		],
		"transform": {
			"^.+\\.ts$": [
				"ts-jest",
				{
					"tsconfig": {
						"module": "commonjs",
						"moduleResolution": "node10"
					}
				}
			]
		},
		"moduleNameMapper": {
			"^@bluprint/shared$": "<rootDir>/../../packages/shared/src/index.ts",
			"^(\\.{1,2}/.*)\\.js$": "$1"
		},
		"testEnvironment": "node",
		"collectCoverageFrom": [
			"src/**/*.ts"
		]
	}
}
