{
	"name": "@bluprint/api",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run --hot --env-file=../../.env src/index.ts",
		"start": "bun run src/index.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"build": "bun build src/index.ts --target=bun --outdir dist"
	},
	"dependencies": {
		"@bluprint/shared": "workspace:*",
		"@hono/zod-validator": "^0.9.0",
		"hono": "^4.13.5",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"typescript": "7.0.2"
	}
}
