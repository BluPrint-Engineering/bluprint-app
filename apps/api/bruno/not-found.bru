meta {
  name: Unknown route
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/no-such-route
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.body.error: eq Not Found
}

docs {
  A route that does not exist. It checks the API's error contract: every non-2xx
  answers `{"error": "..."}`, not the verbose body Nest returns by default.

  `AllExceptionsFilter` is what holds this up. If it goes away, this request is
  the first to notice — the web app throws on any non-2xx without reading the
  body.
}
