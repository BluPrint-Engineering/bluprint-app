meta {
  name: Health check (no verbose)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq ok
  res.body.database: eq up
  res.body.verbose: isUndefined
}

docs {
  The same health check without `verbose`, the minimal response shape. It exists
  separately to prove the parameter really is optional and that `verbose`
  disappears from the body when not requested.
}
