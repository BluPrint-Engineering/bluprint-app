meta {
  name: Health check (sem verbose)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq ok
  res.body.database: eq up
  res.body.verbose: isUndefined
}

docs {
  O mesmo health check sem `verbose`, que é o formato mínimo da resposta. Existe
  separado para provar que o parâmetro é de fato opcional e que `verbose` some do
  corpo quando não é pedido.
}
