meta {
  name: Health check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/health?verbose=true
  body: none
  auth: none
}

params:query {
  verbose: true
}

assert {
  res.status: eq 200
  res.body.status: eq ok
  res.body.database: eq up
  res.body.verbose.runtime: contains node
}

docs {
  Tells whether the API is up and whether it reaches Postgres. `status` is `ok`
  with the database up and `degraded` when it goes down after boot; `database`
  is `up` or `down`. The response always carries `timestamp` and `uptime` in
  seconds.

  `verbose=true` adds the `verbose` block, with `environment` and `runtime`.

  It is the route deployment will use as a healthcheck and the API's **only
  public route**: every other one is born protected by the global `AuthGuard`,
  and this is the explicit exception, marked with `@AllowAnonymous()` in the
  controller.
}
