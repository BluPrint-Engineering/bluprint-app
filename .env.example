# ── apps/api ────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Postgres — local container here; production is Neon, set as a Fly secret (docs/adr/0059-first-deploy-neon-fly-pages.md).
# DATABASE_URL* must match the three lines below by hand: dotenv does not expand ${VAR}.
POSTGRES_USER=bluprint
POSTGRES_PASSWORD=bluprint
POSTGRES_DB=bluprint
DATABASE_URL=postgresql://bluprint:bluprint@localhost:5432/bluprint
DATABASE_URL_TEST=postgresql://bluprint:bluprint@localhost:5432/bluprint_test
# DATABASE_URL_E2E=postgresql://bluprint:bluprint@localhost:5432/bluprint_e2e

# Only for `db:seed` against a remote database (host other than localhost). Both are
# required there and ignored locally. SEED_ALLOW_HOST must equal the DATABASE_URL
# hostname, so a typo'd URL cannot be wiped; SEED_PASSWORD becomes every seeded account's
# password (8-64 characters, must pass docs/adr/0052-password-policy.md) and is never printed.
# SEED_ALLOW_HOST=
# SEED_PASSWORD=

# A git worktree gets these from its own .env.local instead — never set them
# here (docs/adr/0049-per-worktree-isolation.md).
# WEB_PORT=5173
# E2E_API_PORT=3100
# E2E_WEB_PORT=5273

# Cloudflare R2 — issue #19
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# Better Auth — signs the session cookie. Required: the API does not boot without it.
# Generate yours with `openssl rand -base64 32`; never reuse the dev one in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Self-signup is scaffolding and defaults to off, so it cannot leak into production
# by omission: without this line the sign-up route answers 403. Why:
# docs/adr/0011-self-signup-is-scaffolding.md. Never leave it empty: it accepts
# true/1/yes/on and false/0/no/off, and rejects an empty string.
ALLOW_SELF_SIGNUP=true
# Its web twin shows the /signup screen; off, /signup redirects to /login. Same
# values and default, but Vite inlines it at build time: rebuild or restart the web
# dev server after changing it. Keep the two in step — both leave in #87 (epic #11).
VITE_ALLOW_SELF_SIGNUP=true

# Checks every new password against Have I Been Pwned (k-anonymity: only 5 chars of its
# SHA-1 leave). Defaults to on; while the HIBP API is unreachable, setting a password
# fails — docs/adr/0052-password-policy.md. Turn off only to work offline.
# PASSWORD_BREACH_CHECK=false

# API documentation at /api/docs (Swagger UI) and /api/docs/openapi.json.
# Defaults to on outside production, off in it — docs/adr/0046-openapi-via-nestjs-swagger.md.
# Uncomment to override either way.
# API_DOCS_ENABLED=true

# Shared secret between the Pages Function and the API (>= 32 characters, e.g.
# `openssl rand -base64 32`). With it set, the API answers 403 to anything that lacks
# it in X-Proxy-Secret, except GET /api/health, and takes the client IP for the rate
# limit from X-Client-IP. Required when NODE_ENV=production; leave it unset in dev,
# where the Vite proxy sends no header. Why: docs/adr/0058-api-only-answers-the-pages-proxy.md.
# PROXY_SECRET=

# ── apps/web ────────────────────────────────────────────
# VITE_ALLOW_SELF_SIGNUP sits with ALLOW_SELF_SIGNUP above. There is no API URL:
# the web app calls /api on its own origin, and in dev the Vite server proxies it
# to the API. Only VITE_-prefixed variables reach the browser.

# The Pages Function (apps/web/functions) that proxies /api/* reads two bindings, set in
# the Pages project in production. To run it locally, after `bun run --filter @bluprint/web build`:
#   cd apps/web && bunx wrangler pages dev dist --binding API_ORIGIN=http://localhost:3000 --binding PROXY_SECRET=<the API's PROXY_SECRET>
# API_ORIGIN — where the API listens, no trailing path.
# PROXY_SECRET — the same value as the API's.
