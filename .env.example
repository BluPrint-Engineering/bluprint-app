# ── apps/api ────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Postgres — provider still open (docs/adr/0015-hosting-and-providers-deferred.md).
# DATABASE_URL* must match the three lines below by hand: dotenv does not expand ${VAR}.
POSTGRES_USER=bluprint
POSTGRES_PASSWORD=bluprint
POSTGRES_DB=bluprint
DATABASE_URL=postgresql://bluprint:bluprint@localhost:5432/bluprint
DATABASE_URL_TEST=postgresql://bluprint:bluprint@localhost:5432/bluprint_test

# Cloudflare R2 — issue #19
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# Better Auth — signs the session cookie. Required: the API does not boot without it.
# Generate yours with `openssl rand -base64 32`; never reuse the dev one in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Self-signup is scaffolding and defaults to off, so it cannot leak into production
# by omission: without this line the sign-up route answers 403. Why:
# docs/adr/0011-self-signup-is-scaffolding.md. Never leave it empty: it accepts
# true/1/yes/on and false/0/no/off, and rejects an empty string.
ALLOW_SELF_SIGNUP=true

# ── apps/web ────────────────────────────────────────────
# No web variables yet. There is no API URL: the web app calls /api on its own
# origin, and in dev the Vite server proxies it to the API.
# Only VITE_-prefixed variables reach the browser.
