# ── apps/api ────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Postgres — provedor em aberto (ver docs/ARCHITECTURE.md § Hospedagem e provedores).
# DATABASE_URL* precisa bater com as três linhas abaixo à mão — dotenv não expande ${VAR}.
POSTGRES_USER=bluprint
POSTGRES_PASSWORD=bluprint
POSTGRES_DB=bluprint
DATABASE_URL=postgresql://bluprint:bluprint@localhost:5432/bluprint
DATABASE_URL_TEST=postgresql://bluprint:bluprint@localhost:5432/bluprint_test

# Cloudflare R2 — issue #19
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# Better Auth — assina o cookie de sessão. Obrigatório: a API não sobe sem ele.
# Gere o seu com `openssl rand -base64 32`; não reaproveite o de dev em produção.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── apps/web ────────────────────────────────────────────
# Nenhuma variável do front por enquanto. A URL da API não existe: o front chama
# /api na própria origem, e em dev o servidor do Vite faz proxy para a API.
# Só variáveis com prefixo VITE_ chegam ao browser.
